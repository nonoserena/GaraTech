# ═══════════════════════════════════════════════════════════
# GARATECH - Variables d'environnement
# Copier ce fichier en ".env" et remplir les vraies valeurs.
# NE JAMAIS committer le fichier ".env" réel.
# ═══════════════════════════════════════════════════════════

# ─── PostgreSQL ───
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# ─── JWT (sécurité Supabase Auth / RLS) ───
# JWT_SECRET : chaîne aléatoire d'au moins 32 caractères.
#   Génération : openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRY=3600

# ANON_KEY et SERVICE_ROLE_KEY : générés à partir du JWT_SECRET.
# Utiliser l'outil officiel Supabase :
#   https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys
# ou le générateur communautaire : https://supabase.com/docs/guides/self-hosting#api-keys
ANON_KEY=
SERVICE_ROLE_KEY=

# REALTIME_SECRET_KEY_BASE : chaîne aléatoire longue.
#   Génération : openssl rand -base64 64
REALTIME_SECRET_KEY_BASE=

# ─── URLs & Ports ───
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=
STUDIO_PORT=54323
KONG_HTTP_PORT=8000

# ─── SMTP (envoi d'emails - confirmation compte, notifications) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ═══════════════════════════════════════════════════════════
# Application Next.js (apps/web/.env.local)
# ═══════════════════════════════════════════════════════════

# Connexion Supabase côté client (via Kong Gateway local)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Connexion Supabase côté serveur (Prisma / API Routes)
DATABASE_URL=postgresql://postgres:change_this_password@localhost:5432/postgres
SUPABASE_SERVICE_ROLE_KEY=

# ─── SMS/WhatsApp (lien de tracking client - Module 1) ───
# Exemple avec Twilio, à adapter selon le prestataire choisi
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# ─── Cartographie (Module 4) ───
# Leaflet/OSM ne nécessite pas de clé API, laissé ici pour référence
# future si un fournisseur de tuiles payant est ajouté.
NEXT_PUBLIC_MAP_TILE_PROVIDER=osm
